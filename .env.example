# Supabase Database Credentials (Vite standard or NEXT_PUBLIC_)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary Image Management Credentials
VITE_CLOUDINARY_CLOUD_NAME=kllyeein-gadgets
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=kllyeein-gadgets
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Gemini AI Key (AI Gadget Advisor)
GEMINI_API_KEY=your-gemini-api-key

# Site Domain URL (Optional)
VITE_SITE_URL=https://kllyeein-gadgets.vercel.app
