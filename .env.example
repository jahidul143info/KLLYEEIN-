# Next.js Public Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase Service Role Key (Optional)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary Image Management Credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=kllyeein-gadgets
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Gemini AI Key (Server-side AI Gadget Advisor)
GEMINI_API_KEY=your-gemini-api-key

# Vercel Deployment Domain / Site URL
NEXT_PUBLIC_SITE_URL=https://kllyeein-gadgets.vercel.app
